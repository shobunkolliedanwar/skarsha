# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# String acak bebas, minimal 32 karakter, untuk menandatangani session login admin
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Opsional: snippet HTML/script embed dari ad network (Adsterra, PropellerAds, AdSense, dll).
# Muncul di halaman "Mengalihkan ke..." (redirect) dan banner landing/Jelajahi.
# Kalau dikosongkan, akan tampil placeholder "Ruang Iklan" (aman untuk development).
NEXT_PUBLIC_AD_SLOT_INTERSTITIAL=

# Tripay (pembayaran premium) — ambil dari Dashboard Tripay > Merchant > Detail Merchant
# Daftar dulu di https://tripay.co.id (mode sandbox buat testing sebelum live)
TRIPAY_MODE=sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=

# URL publik aplikasi kamu (dipakai buat callback_url & return_url ke Tripay).
# WAJIB https dan bisa diakses dari internet — localhost TIDAK BISA dipakai
# Tripay untuk mengirim webhook. Pakai domain produksi/staging kamu, atau
# tunnel (ngrok/cloudflared) kalau mau test webhook dari localhost.
NEXT_PUBLIC_APP_URL=https://domainkamu.com
